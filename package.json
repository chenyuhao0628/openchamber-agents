{
  "name": "openchamber-agents",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "OpenChamber 全局规则方案：编辑、差异预览、切换与备份恢复。",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.4.0"
    },
    "contributes": {
      "panel": {
        "id": "agents-manager",
        "name": "规则方案",
        "icon": "quill-pen",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "panel/section.html",
        "title": "全局规则",
        "height": 64
      },
      "filesystem": [
        "~/.config/opencode/AGENTS.md",
        "~/.config/openchamber/agents-manager/**"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "node scripts/preview.mjs",
    "share": "node scripts/share.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.0.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "panel/",
    "README.md"
  ]
}
